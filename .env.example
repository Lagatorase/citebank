# Copy this file to .env and fill in what you need.

# Which LLM answers questions: ollama, openai or anthropic
LLM_BACKEND=ollama

# Ollama runs locally on your GPU (https://ollama.com). Pull the model first: ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Hosted APIs (only needed if you switch LLM_BACKEND). Check each provider's docs for current model names.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Embeddings: local (sentence-transformers on your GPU) or openai
EMBED_BACKEND=local
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBED_MODEL=text-embedding-3-small

# Reranker used when retrieval mode has reranking switched on
RERANK_MODEL=BAAI/bge-reranker-base

# Retrieval defaults
RETRIEVAL_MODE=hybrid
USE_RERANKER=true
TOP_K=5
# Questions naming two or more banks search each bank separately, so every bank appears in the sources
MULTI_BANK_SPLIT=true
CHUNK_STRATEGY=structured
CHUNK_SIZE=220
CHUNK_OVERLAP=40

# Paths
RAW_DIR=data/raw
INDEX_DIR=data/index
